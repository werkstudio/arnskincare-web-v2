---
import { ingredients } from '../data/products';
---

<section class="px-3 sm:px-4" aria-labelledby="ingredients-title">
  <div class="stage bg-[radial-gradient(90%_70%_at_20%_10%,#f2c4cb_0%,#d98a98_45%,#9e4459_100%)] px-5 py-20 sm:px-10 md:py-28">
    <div class="pointer-events-none absolute -right-20 -top-20 h-96 w-96 rounded-full border border-white/25" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-32 -left-16 h-[28rem] w-[28rem] rounded-full border border-white/15" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-6xl">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="max-w-xl">
          <span class="eyebrow !text-white">Di balik formula</span>
          <h2 id="ingredients-title" class="mt-4 font-display text-[clamp(2rem,5vw,3.5rem)] font-medium leading-[1.05] tracking-[-0.015em] text-white">
            Bahan yang kamu bisa pahami.
          </h2>
        </div>
        <p class="max-w-sm text-sm leading-relaxed text-white/80">
          Kami percaya kamu berhak tahu apa yang kamu oleskan ke wajah. Inilah bahan bintang di rangkaian ARN, dan alasan kami memilihnya.
        </p>
      </div>

      <ul class="mt-14 grid grid-cols-2 gap-x-4 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
        {ingredients.map((ing) => (
          <li class="group text-white">
            <div class="relative mx-auto grid aspect-square w-full max-w-[180px] place-items-center rounded-full border border-white/50 bg-white/15 shadow-[inset_0_2px_20px_rgb(255_255_255/0.35),0_20px_40px_-20px_rgb(80_20_40/0.5)] backdrop-blur-md transition duration-500 group-hover:scale-105 group-hover:bg-white/25">
              <span class="absolute left-[22%] top-[16%] h-[18%] w-[30%] -rotate-[30deg] rounded-full bg-white/50 blur-[6px]" aria-hidden="true"></span>
              <span class="px-3 text-center">
                <span class="block text-xs font-medium text-white/80">{ing.role}</span>
                <span class="mt-1 block font-display text-lg leading-tight sm:text-xl">{ing.name}</span>
              </span>
            </div>
            <p class="mx-auto mt-4 max-w-[220px] text-center text-xs leading-relaxed text-white/80 sm:text-sm">{ing.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
