---
import { Image } from 'astro:assets';
import { ingredients, products } from '../data/products';

// each ingredient is linked to the ARN products whose formula lists it
const index = ingredients.map((ing) => ({
  ...ing,
  products: products.filter((p) => p.ingredients.includes(ing.name)),
}));
const first = index[0].products[0].slug;
---

<section id="bahan" class="px-3 sm:px-4" aria-labelledby="ingredients-title" data-ingredients>
  <div class="stage overflow-clip bg-blush px-5 py-20 text-ink sm:px-10 md:py-28">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
        <h2 id="ingredients-title" class="font-display text-h2 font-medium lg:col-span-7" data-reveal>
          Bahan yang kamu bisa pahami.
        </h2>
        <p class="max-w-md text-body text-ink lg:col-span-5 lg:justify-self-end" data-reveal>
          Kamu berhak tahu apa yang kamu oleskan ke wajah. Delapan bahan bintang ARN, fungsinya, dan produk tempat kamu menemukannya.
        </p>
      </div>

      <div class="mt-14 grid gap-12 md:mt-20 lg:grid-cols-12 lg:gap-16">
        <ol class="space-y-20 lg:col-span-7">
          {index.map((ing) => (
            <li data-reveal data-ing={ing.products[0].slug}>
              <h3 class="font-display text-h2 font-medium">{ing.name}</h3>
              <p class="mt-3 max-w-xl text-body text-ink">
                <span class="font-semibold text-indigo">{ing.role}.</span> {ing.text}
              </p>
              <p class="mt-4 flex flex-wrap items-center gap-2 text-body">
                <span class="mr-1 text-ink">Ada di</span>
                {ing.products.map((p) => (
                  <a
                    href={`#${p.slug}`}
                    data-ing-link={p.slug}
                    class="inline-flex min-h-11 items-center gap-2.5 rounded-full bg-cream/70 py-1.5 pl-1.5 pr-4 font-semibold text-ink transition-colors duration-300 hover:bg-cream focus-visible:bg-cream"
                  >
                    <Image src={p.image} alt="" widths={[64]} sizes="32px" class="h-8 w-8 rounded-full object-cover" />
                    {p.name}
                  </a>
                ))}
              </p>
            </li>
          ))}
        </ol>

        <!-- desktop preview: shows the product a hovered or focused ingredient lives in -->
        <div class="hidden lg:col-span-5 lg:block" aria-hidden="true">
          <div class="sticky top-28">
            <div class="stage aspect-[4/5] bg-rose/40">
              {products.map((p) => (
                <Image
                  src={p.image}
                  alt=""
                  widths={[480, 720]}
                  sizes="40vw"
                  data-ing-shot={p.slug}
                  class={`absolute inset-0 h-full w-full object-cover transition-opacity duration-500 ${p.slug === first ? 'opacity-100' : 'opacity-0'}`}
                />
              ))}
            </div>
            {products.map((p) => (
              <p data-ing-caption={p.slug} class={`mt-5 text-body text-ink ${p.slug === first ? '' : 'hidden'}`}>
                <span class="font-display text-h3 font-medium">ARN {p.name}</span><br />
                Langkah {p.step} · {p.ritual} — {p.ingredients.join(', ')}
              </p>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-ingredients]');
  if (root) {
    const show = (slug: string) => {
      root.querySelectorAll<HTMLElement>('[data-ing-shot]').forEach((el) => {
        el.classList.toggle('opacity-100', el.dataset.ingShot === slug);
        el.classList.toggle('opacity-0', el.dataset.ingShot !== slug);
      });
      root.querySelectorAll<HTMLElement>('[data-ing-caption]').forEach((el) => {
        el.classList.toggle('hidden', el.dataset.ingCaption !== slug);
      });
    };
    root.querySelectorAll<HTMLElement>('[data-ing]').forEach((row) => {
      row.addEventListener('pointerenter', () => show(row.dataset.ing!));
    });
    root.querySelectorAll<HTMLElement>('[data-ing-link]').forEach((link) => {
      const go = () => show(link.dataset.ingLink!);
      link.addEventListener('pointerenter', go);
      link.addEventListener('focus', go);
    });
  }
</script>
