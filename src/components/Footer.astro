---
import { Image } from 'astro:assets';
import logo from '../assets/products/arn-black.png';
import { products } from '../data/products';

const year = new Date().getFullYear();
---

<footer class="px-5 pb-10 pt-16 sm:px-8" aria-labelledby="footer-title">
  <h2 id="footer-title" class="sr-only">Informasi ARN Skincare</h2>
  <div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <Image src={logo} alt="ARN Skincare" width={110} class="h-auto w-[96px]" />
      <p class="mt-4 max-w-xs text-body text-ink">Skincare lembut untuk kulit tropis yang tenang, sehat, dan bercahaya. Seluruh produk terdaftar BPOM.</p>
    </div>
    <nav aria-label="Produk">
      <h3 class="text-body font-semibold text-indigo">Produk</h3>
      <ul class="mt-4 space-y-2 text-body">
        {products.map((p) => <li><a href={`#${p.slug}`} class="hover:text-rose-deep">{p.name}</a></li>)}
      </ul>
    </nav>
    <div>
      <h3 class="text-body font-semibold text-indigo">Terhubung</h3>
      <!-- TODO: replace with real social and marketplace links -->
      <ul class="mt-4 space-y-2 text-body">
        <li><a href="#mulai" class="hover:text-rose-deep">WhatsApp</a></li>
        <li><a href="#" class="hover:text-rose-deep">Instagram</a></li>
        <li><a href="#" class="hover:text-rose-deep">TikTok</a></li>
        <li><a href="#" class="hover:text-rose-deep">Marketplace</a></li>
      </ul>
    </div>
  </div>
  <div class="mx-auto mt-16 flex max-w-7xl flex-col justify-between gap-2 text-small text-muted sm:flex-row">
    <p>© {year} ARN Skincare. Seluruh hak dilindungi.</p>
    <p>arnskincare.id</p>
  </div>
</footer>
