---
import { products } from '../data/products';

const stats = [
  { value: 5, suffix: '', label: 'Produk terdaftar BPOM' },
  { value: 50, suffix: '+', label: 'SPF pada Day Cream, PA++++' },
  { value: 0, suffix: '%', label: 'Alkohol pada Toner Essence' },
  { value: 100, suffix: '%', label: 'Rangkaian teruji klinis' },
];

const promises = [
  { title: 'Teruji klinis', text: 'Setiap produk melewati uji klinis sebelum sampai ke tanganmu.' },
  { title: 'Non-komedogenik', text: 'Day Cream diformulasikan agar tidak menyumbat pori.' },
  { title: 'Ramah kulit sensitif', text: 'Formula lembut, bebas alkohol pada toner, tanpa bahan keras yang mengiritasi.' },
];

/*
 * Customer reviews: add real, consented reviews here to render the testimonial row.
 * Example: { quote: '...', name: 'Nama, kota', skin: 'Kulit sensitif' }
 */
const testimonials: { quote: string; name: string; skin: string }[] = [];
---

<section id="kepercayaan" class="px-5 py-20 sm:px-8 md:py-32" aria-labelledby="trust-title">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-10 md:grid-cols-[1fr_1.2fr] md:gap-16">
      <div>
        <span class="eyebrow">Mengapa percaya ARN</span>
        <h2 id="trust-title" class="mt-4 font-display text-[clamp(2rem,5vw,3.5rem)] font-medium leading-[1.05] tracking-[-0.015em]">
          Jangan percaya kata-kata kami. Periksa sendiri.
        </h2>
        <p class="mt-6 max-w-md leading-relaxed text-muted">
          Semua nomor registrasi ARN terbuka. Masukkan nomornya di situs resmi BPOM dan lihat sendiri produk yang terdaftar.
        </p>
        <ul class="mt-8 space-y-4">
          {promises.map((p) => (
            <li class="flex gap-4">
              <span class="mt-1 grid h-7 w-7 shrink-0 place-items-center rounded-full bg-indigo text-cream">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m3.5 8.5 3 3 6-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <div>
                <h3 class="font-semibold">{p.title}</h3>
                <p class="mt-1 text-sm text-muted">{p.text}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="flex flex-col gap-4">
        <dl class="grid grid-cols-2 gap-4">
          {stats.map((s) => (
            <div class="stage glass flex flex-col p-6 sm:p-8">
              <dt class="order-2 mt-2 text-sm text-muted">{s.label}</dt>
              <dd class="font-display text-5xl font-medium tracking-tight text-indigo sm:text-6xl">
                <span data-count={s.value}>{s.value}</span>{s.suffix}
              </dd>
            </div>
          ))}
        </dl>

        <div class="stage bg-cream p-6 sm:p-8">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h3 class="font-display text-2xl">Nomor registrasi BPOM</h3>
            <a href="https://cekbpom.pom.go.id/" target="_blank" rel="noopener" class="text-sm font-semibold text-indigo underline decoration-indigo/30 underline-offset-4 hover:decoration-indigo">Cek nomor di situs BPOM</a>
          </div>
          <ul class="mt-5 divide-y divide-ink/10">
            {products.map((p) => (
              <li class="flex items-center justify-between gap-4 py-3 text-sm">
                <span>ARN {p.name}</span>
                <span class="text-xs tabular-nums text-ink/60">{p.bpom ?? 'Terdaftar'}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    {testimonials.length > 0 && (
      <ul class="mt-16 grid gap-4 md:grid-cols-3">
        {testimonials.map((t) => (
          <li class="stage bg-cream p-6 sm:p-8">
            <blockquote class="font-display text-xl leading-snug">“{t.quote}”</blockquote>
            <p class="mt-6 text-sm font-semibold">{t.name}</p>
            <p class="text-xs text-muted">{t.skin}</p>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>
