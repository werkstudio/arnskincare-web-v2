---
import { Image, getImage } from 'astro:assets';
import heroImg from '../assets/products/facial-wash-editorial.jpg';

/*
 * Veo 3.1 Fast loop (8s, 960px square crop of the 16:9 render, no audio). The editorial
 * still stays underneath as LCP image and reduced-motion fallback; the video fades in once playing.
 * The stage gradient matches the render's backdrop (#b7ada5 → #eee6df) so the masked video melts in.
 */
const heroVideo: { webm: string; mp4: string } | null = { webm: '/video/hero.webm', mp4: '/video/hero.mp4' };
const poster = await getImage({ src: heroImg, width: 960, format: 'webp' });

/*
 * Positions: phone/tablet use vw so they track the vw-sized word and bottle; desktop (lg) uses
 * stage percentages around the centred bottle.
 */
const callouts = [
  { label: 'Cica', note: 'menenangkan kemerahan', pos: 'sm:left-[4%] sm:top-[64vw] lg:left-[12%] lg:top-[56%]', side: 'r' },
  { label: 'Gluconolactone', note: 'menghaluskan tekstur', pos: 'sm:right-[4%] sm:top-[48vw] lg:right-[13%] lg:top-[26%]', side: 'l' },
  { label: '100 g', note: 'untuk semua jenis kulit', pos: 'sm:right-[5%] sm:top-[76vw] lg:right-[18%] lg:top-auto lg:bottom-[40%]', side: 'l' },
];
---

<section id="top" class="px-2 pt-2 sm:px-3 sm:pt-3" aria-labelledby="hero-title">
  <div class="stage hero-stage relative flex min-h-[100svh] flex-col sm:min-h-[calc(100svh-1.5rem)]">
    <!-- the word: the giant "Gentle" is the page title; the rest of the product name is for screen readers -->
    <h1
      id="hero-title"
      class="pointer-events-none absolute inset-x-0 top-[28vw] text-center font-display text-[33vw] font-semibold leading-[0.8] tracking-[-0.055em] text-indigo sm:top-[20vw] lg:top-[17%] lg:text-[25.5vw]"
      style="font-variation-settings: 'opsz' 144, 'SOFT' 30;"
      data-hero-word
    >
      Gentle<span class="sr-only"> Facial Wash ARN</span>
    </h1>

    <!-- product -->
    <div class="pointer-events-none absolute left-1/2 top-[38vw] aspect-square w-[68vw] -translate-x-1/2 sm:top-[34vw] sm:w-[54vw] lg:top-[38%] lg:w-[min(64vh,720px)]" data-hero-product>
      <div class="hero-mask relative h-full w-full" data-float>
        <Image
          src={heroImg}
          alt="ARN Gentle Facial Wash dengan Cica dan Gluconolactone, botol putih berlabel merah muda"
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 1024px) 64vh, (min-width: 640px) 54vw, 68vw"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover"
        />
        {heroVideo && (
          <video
            class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-1000 [&.is-playing]:opacity-100"
            muted
            loop
            playsinline
            preload="none"
            poster={poster.src}
            aria-hidden="true"
            data-hero-video
          >
            <source src={heroVideo.webm} type="video/webm" />
            <source src={heroVideo.mp4} type="video/mp4" />
          </video>
        )}
      </div>
    </div>

    <!-- callouts -->
    <ul class="pointer-events-none absolute inset-0 hidden sm:block" aria-label="Kandungan Gentle Facial Wash">
      {callouts.map((c) => (
        <li class={`absolute flex items-center gap-3 ${c.pos} ${c.side === 'l' ? 'flex-row-reverse text-right' : ''}`} data-callout>
          <span class="rounded-2xl bg-white/70 px-4 py-2.5 backdrop-blur-md">
            <span class="block text-small font-semibold text-indigo">{c.label}</span>
            <span class="block text-small text-ink">{c.note}</span>
          </span>
          <span class="h-px w-10 bg-indigo/40 lg:w-20" aria-hidden="true"></span>
          <span class="h-2 w-2 rounded-full bg-indigo ring-4 ring-white/60" aria-hidden="true"></span>
        </li>
      ))}
    </ul>

    <!-- copy -->
    <div class="relative z-10 mt-auto grid gap-6 px-5 pb-7 pt-[104vw] sm:px-8 sm:pb-9 sm:pt-[90vw] lg:grid-cols-[1fr_auto] lg:items-end lg:gap-12 lg:px-12 lg:pb-12 lg:pt-0">
      <div class="max-w-[32rem]" data-hero-in>
        <p class="text-balance font-display text-h3 font-medium text-ink">
          Pembersih wajah lembut untuk kulit kemerahan.
        </p>
        <p class="mt-4 max-w-[27rem] text-body text-ink">
          Cica menenangkan, gluconolactone menghaluskan. Bersih tanpa rasa ketarik, pagi dan malam. Terdaftar BPOM NA18241203311.
        </p>
        <ul class="mt-4 flex flex-wrap gap-1.5 sm:hidden" aria-label="Kandungan Gentle Facial Wash">
          {callouts.map((c) => (
            <li class="rounded-full bg-white/70 px-3 py-1.5 text-small text-ink">
              <span class="font-semibold text-indigo">{c.label}</span> {c.note}
            </li>
          ))}
        </ul>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:items-end" data-hero-in>
        <a href="#ritual" class="btn min-h-12 bg-indigo text-cream hover:bg-ink">Lihat ritual lengkap</a>
        <a href="#mulai" class="btn min-h-12 bg-white/70 text-indigo backdrop-blur hover:bg-white">Konsultasi gratis</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-stage {
    background:
      radial-gradient(60% 45% at 50% 40%, rgb(242 196 203 / 0.35), transparent 70%),
      linear-gradient(180deg, #b9afa8 0%, #cdc2bb 38%, #e6ddd5 70%, #ece4dd 100%);
  }
  .hero-mask {
    /* hug the bottle (incl. its sway) so the word stays readable around it */
    -webkit-mask-image: radial-gradient(ellipse 32% 48% at 50% 45%, #000 78%, transparent 100%);
    mask-image: radial-gradient(ellipse 32% 48% at 50% 45%, #000 78%, transparent 100%);
  }
</style>
