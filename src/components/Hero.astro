---
import { Image } from 'astro:assets';
import heroImg from '../assets/products/facial-wash-editorial.jpg';

/*
 * Veo 3.1 Fast loop (8s, 960px square crop of the 16:9 render, no audio). The editorial
 * still stays underneath as LCP image and reduced-motion fallback; the video fades in once playing.
 * The stage gradient matches the render's backdrop (#b7ada5 → #eee6df) so the masked video melts in.
 */
const heroVideo: { webm: string; mp4: string } | null = { webm: '/video/hero.webm', mp4: '/video/hero.mp4' };

const callouts = [
  { label: 'Cica', note: 'menenangkan kemerahan', pos: 'left-[2%] top-[62%] md:left-[12%] md:top-[56%]', side: 'r' },
  { label: 'Gluconolactone', note: 'menghaluskan tekstur', pos: 'right-[2%] top-[18%] md:right-[13%] md:top-[26%]', side: 'l' },
  { label: '100 g', note: 'untuk semua jenis kulit', pos: 'right-[4%] bottom-[30%] md:right-[18%] md:bottom-[40%]', side: 'l' },
];
---

<section id="top" class="px-2 pt-2 sm:px-3 sm:pt-3" aria-labelledby="hero-title">
  <div class="stage hero-stage relative flex min-h-[100svh] flex-col sm:min-h-[calc(100svh-1.5rem)]">
    <!-- the word -->
    <p
      class="pointer-events-none absolute inset-x-0 top-[24%] select-none text-center font-display text-[33vw] font-semibold leading-[0.8] tracking-[-0.055em] text-indigo md:top-[17%] md:text-[25.5vw]"
      style="font-variation-settings: 'opsz' 144, 'SOFT' 30;"
      aria-hidden="true"
      data-hero-word
    >
      Gentle
    </p>

    <!-- product -->
    <div class="pointer-events-none absolute left-1/2 top-[19%] aspect-square w-[min(108vw,640px)] -translate-x-1/2 md:top-[6%] md:w-[min(64vh,720px)]" data-hero-product>
      <div class="hero-mask relative h-full w-full" data-float>
        <Image
          src={heroImg}
          alt="ARN Gentle Facial Wash dengan Cica dan Gluconolactone, botol putih berlabel merah muda"
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 768px) 64vh, 100vw"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover"
        />
        {heroVideo && (
          <video
            class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-1000 [&.is-playing]:opacity-100"
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
            data-hero-video
          >
            <source src={heroVideo.webm} type="video/webm" />
            <source src={heroVideo.mp4} type="video/mp4" />
          </video>
        )}
      </div>
    </div>

    <!-- callouts -->
    <ul class="pointer-events-none absolute inset-0 hidden sm:block" aria-label="Kandungan Gentle Facial Wash">
      {callouts.map((c) => (
        <li class={`absolute flex items-center gap-3 ${c.pos} ${c.side === 'l' ? 'flex-row-reverse text-right' : ''}`} data-callout>
          <span class="rounded-2xl bg-white/70 px-4 py-2.5 shadow-[0_12px_30px_-18px_rgb(61_63_143/0.5)] backdrop-blur-md">
            <span class="block text-sm font-semibold text-indigo">{c.label}</span>
            <span class="block text-xs text-ink/60">{c.note}</span>
          </span>
          <span class="h-px w-10 bg-indigo/40 lg:w-20" aria-hidden="true"></span>
          <span class="h-2 w-2 rounded-full bg-indigo ring-4 ring-white/60" aria-hidden="true"></span>
        </li>
      ))}
    </ul>

    <!-- copy -->
    <div class="relative z-10 mt-auto grid gap-6 px-5 pb-7 pt-[118vw] sm:px-8 sm:pb-9 sm:pt-[78vw] md:grid-cols-[1fr_auto] md:items-end md:gap-12 md:pt-0 lg:px-12 lg:pb-12">
      <div class="max-w-[30rem]" data-hero-in>
        <h1 id="hero-title" class="font-display text-[clamp(1.9rem,3.6vw,3rem)] font-medium leading-[1.06] tracking-[-0.02em] text-ink">
          Pembersih lembut untuk kulit yang mudah kemerahan.
        </h1>
        <p class="mt-4 max-w-[26rem] text-[0.95rem] leading-relaxed text-ink/70">
          Cica menenangkan, gluconolactone menghaluskan. Wajah bersih tanpa rasa ketarik, setiap pagi dan malam.
        </p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row md:flex-col md:items-end lg:flex-row" data-hero-in>
        <a href="#ritual" class="btn bg-indigo text-cream hover:bg-ink">Lihat ritual lengkap</a>
        <a href="#mulai" class="btn bg-white/70 text-indigo backdrop-blur hover:bg-white">Konsultasi gratis</a>
      </div>
    </div>

    <p class="absolute left-5 top-24 z-10 text-xs font-medium text-ink/60 sm:left-8 lg:left-12" data-hero-in>
      Terdaftar BPOM NA18241203311
    </p>
  </div>
</section>

<style>
  .hero-stage {
    background:
      radial-gradient(60% 45% at 50% 40%, rgb(242 196 203 / 0.35), transparent 70%),
      linear-gradient(180deg, #b9afa8 0%, #cdc2bb 38%, #e6ddd5 70%, #ece4dd 100%);
  }
  .hero-mask {
    /* hug the bottle (incl. its sway) so the word stays readable around it */
    -webkit-mask-image: radial-gradient(ellipse 34% 48% at 50% 45%, #000 64%, transparent 100%);
    mask-image: radial-gradient(ellipse 34% 48% at 50% 45%, #000 64%, transparent 100%);
  }
</style>
