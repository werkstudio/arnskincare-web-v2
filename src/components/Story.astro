---
import { Image } from 'astro:assets';
import skinImg from '../assets/story-skin.jpg';
import serumImg from '../assets/products/serum-flat-editorial.jpg';
import washCut from '../assets/lineup/facial-wash.jpg';
import tonerCut from '../assets/lineup/toner.jpg';
import serumCut from '../assets/lineup/serum.jpg';
import dayCut from '../assets/lineup/day-cream.jpg';
import barrierCut from '../assets/lineup/barrier-cream.jpg';

const manifesto =
  'Matahari tropis, polusi kota, masker seharian, dan produk yang terlalu keras. Kulitmu tidak rewel. Ia hanya lelah. Kami membuat ARN untuk memahaminya, bukan melawannya.';
const words = manifesto.split(' ');

// packshots trimmed to their edges, arranged as a group: three bottles behind, two jars in front
const lineup = [
  { src: washCut, pos: 'left-[5%] bottom-[30%] h-[46%]' },
  { src: tonerCut, pos: 'left-1/2 -translate-x-1/2 bottom-[33%] h-[47%]' },
  { src: serumCut, pos: 'right-[5%] bottom-[30%] h-[43%]' },
  { src: dayCut, pos: 'left-[11%] bottom-[9%] h-[22%]' },
  { src: barrierCut, pos: 'right-[11%] bottom-[9%] h-[21%]' },
];

const chapters = [
  {
    n: 'Bab 1',
    title: 'Sudah mencoba banyak hal, kulit justru makin sensitif.',
    body: 'Cerita yang paling sering kami dengar: kemerahan, jerawat yang datang lagi, dan rasa ketarik setelah cuci muka.',
  },
  {
    n: 'Bab 2',
    title: 'Bahan aktif yang bekerja bersama kulit.',
    body: 'Cica untuk menenangkan, probiotik dan ceramide untuk barrier, tranexamic peptide untuk cerah yang merata. Teruji klinis.',
  },
  {
    n: 'Bab 3',
    title: 'Lima langkah yang benar-benar kamu jalani.',
    body: 'Bersihkan, seimbangkan, rawat, lindungi, pulihkan. Cukup sederhana untuk pagi yang terburu-buru.',
  },
];
---

<section id="cerita" class="px-5 pt-24 pb-20 sm:px-8 md:pt-36 md:pb-24 lg:px-12" aria-labelledby="story-title">
  <div class="mx-auto max-w-[78rem]">
    <h2 id="story-title" class="text-sm font-semibold text-indigo">Cerita kami</h2>
    <p class="mt-6 max-w-[22ch] font-display text-[clamp(2rem,5.4vw,4.6rem)] font-normal leading-[1.08] tracking-[-0.025em] text-ink sm:max-w-[24ch]" data-words>
      {words.map((w) => <span class="word">{w} </span>)}
    </p>

    <ol class="mt-20 grid gap-14 sm:grid-cols-2 sm:gap-x-6 md:mt-28 lg:grid-cols-3 lg:gap-8">
      <li class="lg:mt-0">
        <figure class="overflow-hidden rounded-[1.75rem] bg-sand">
          <Image src={skinImg} alt="Perempuan dengan kulit sensitif yang sedikit kemerahan menyentuh pipinya dengan lembut" widths={[480, 720, 960]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 92vw" class="aspect-[4/5] w-full object-cover" data-parallax />
        </figure>
        <p class="mt-6 text-sm font-semibold text-rose-deep">{chapters[0].n}</p>
        <h3 class="mt-2 font-display text-[1.6rem] font-medium leading-[1.15] tracking-[-0.01em]">{chapters[0].title}</h3>
        <p class="mt-3 max-w-[34ch] leading-relaxed text-ink/65">{chapters[0].body}</p>
      </li>
      <li class="lg:mt-24">
        <figure class="overflow-hidden rounded-[1.75rem] bg-sand">
          <Image src={serumImg} alt="ARN Ultra Glowing Serum dengan tranexamic peptide dan ferulic acid" widths={[480, 720, 960]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 92vw" class="aspect-[4/5] w-full object-cover" data-parallax />
        </figure>
        <p class="mt-6 text-sm font-semibold text-rose-deep">{chapters[1].n}</p>
        <h3 class="mt-2 font-display text-[1.6rem] font-medium leading-[1.15] tracking-[-0.01em]">{chapters[1].title}</h3>
        <p class="mt-3 max-w-[34ch] leading-relaxed text-ink/65">{chapters[1].body}</p>
      </li>
      <li class="sm:col-span-2 lg:col-span-1 lg:mt-16">
        <figure class="relative aspect-[4/5] overflow-hidden rounded-[1.75rem] bg-white sm:aspect-[8/5] lg:aspect-[4/5]">
          <div class="absolute inset-y-0 left-1/2 aspect-[4/5] -translate-x-1/2">
            {lineup.map((p) => (
              <Image src={p.src} alt="" height={480} class={`absolute w-auto mix-blend-multiply [filter:brightness(1.04)_contrast(1.04)] ${p.pos}`} />
            ))}
          </div>
          <figcaption class="sr-only">Lima produk ARN: Gentle Facial Wash, Toner Essence, Ultra Glowing Serum, Skin Glowing Day Cream, Skin Glowing Barrier Cream</figcaption>
        </figure>
        <p class="mt-6 text-sm font-semibold text-rose-deep">{chapters[2].n}</p>
        <h3 class="mt-2 font-display text-[1.6rem] font-medium leading-[1.15] tracking-[-0.01em]">{chapters[2].title}</h3>
        <p class="mt-3 max-w-[34ch] leading-relaxed text-ink/65">{chapters[2].body}</p>
      </li>
    </ol>
  </div>
</section>

<style>
  :global(.motion-ok) [data-words] .word { opacity: 0.16; }
</style>
