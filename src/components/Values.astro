---
import { Image } from 'astro:assets';
import barrierImg from '../assets/products/barrier-cream-editorial.jpg';

const values = [
  {
    title: 'Lembut untuk semua kulit',
    text: 'Termasuk kulit sensitif dan berjerawat. Kami menghindari formula yang membuat kulit perih atau ketarik.',
  },
  {
    title: 'Bahan aktif yang jujur',
    text: 'Setiap kandungan utama kami tulis di kemasan dan kami jelaskan fungsinya. Tanpa klaim yang dibesar-besarkan.',
  },
  {
    title: 'Teruji & terdaftar',
    text: 'Seluruh rangkaian telah teruji klinis dan terdaftar di BPOM, sehingga aman untuk dipakai setiap hari.',
  },
  {
    title: 'Dibuat untuk iklim tropis',
    text: 'Tekstur ringan yang cepat meresap, perlindungan SPF 50+ PA++++, dan nyaman di cuaca lembap.',
  },
];
---

<section id="nilai" class="px-3 py-20 sm:px-4 md:py-32" aria-labelledby="values-title">
  <div class="mx-auto grid max-w-7xl gap-12 px-2 sm:px-4 lg:grid-cols-12 lg:gap-16">
    <figure class="lg:col-span-5 lg:sticky lg:top-28 lg:self-start" data-reveal>
      <div class="stage aspect-[4/5] w-full lg:aspect-[5/6]">
        <Image
          src={barrierImg}
          alt="ARN Skin Glowing Barrier Cream dengan ceramide, Cica, dan probiotik"
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 40vw, 92vw"
          class="absolute inset-0 h-full w-full object-cover"
          data-parallax
        />
      </div>
      <figcaption class="mt-6 max-w-md">
        <p class="font-display text-h3">“Kulit yang sehat dimulai dari barrier yang kuat.”</p>
        <p class="mt-3 text-body text-ink">ARN Skin Glowing Barrier Cream</p>
      </figcaption>
    </figure>

    <div class="lg:col-span-7 lg:pt-4">
      <h2 id="values-title" class="font-display text-h2 font-medium" data-reveal>
        Empat hal yang kami pegang di setiap botol.
      </h2>

      <ol class="mt-14 space-y-12 md:mt-20 md:space-y-16">
        {values.map((v) => (
          <li data-reveal>
            <div>
              <h3 class="font-display text-h3 font-medium">{v.title}</h3>
              <p class="mt-4 max-w-xl text-body text-ink">{v.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
