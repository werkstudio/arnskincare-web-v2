---
import { Image } from 'astro:assets';
import barrierImg from '../assets/products/barrier-cream-editorial.jpg';

const values = [
  {
    title: 'Lembut untuk semua kulit',
    text: 'Termasuk kulit sensitif dan berjerawat. Kami menghindari formula yang membuat kulit perih atau ketarik.',
    icon: 'M12 3c3 4 6 6.5 6 10a6 6 0 1 1-12 0c0-3.5 3-6 6-10Z',
  },
  {
    title: 'Bahan aktif yang jujur',
    text: 'Setiap kandungan utama kami tulis di kemasan dan kami jelaskan fungsinya. Tanpa klaim yang dibesar-besarkan.',
    icon: 'M4 12h16M12 4v16M6.5 6.5l11 11M17.5 6.5l-11 11',
  },
  {
    title: 'Teruji & terdaftar',
    text: 'Seluruh rangkaian telah teruji klinis dan terdaftar di BPOM, sehingga aman untuk dipakai setiap hari.',
    icon: 'M12 3 4.5 6v5.5c0 4.5 3.2 8.2 7.5 9.5 4.3-1.3 7.5-5 7.5-9.5V6L12 3Zm-3 9 2.2 2.2L15.5 10',
  },
  {
    title: 'Dibuat untuk iklim tropis',
    text: 'Tekstur ringan yang cepat meresap, perlindungan SPF 50+ PA++++, dan nyaman di cuaca lembap.',
    icon: 'M12 4V2m0 20v-2m8-8h2M2 12h2m13.7-5.7 1.4-1.4M4.9 19.1l1.4-1.4m0-11.4L4.9 4.9m14.2 14.2-1.4-1.4M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z',
  },
];
---

<section id="nilai" class="px-3 py-20 sm:px-4 md:py-32" aria-labelledby="values-title">
  <div class="mx-auto max-w-7xl px-2 sm:px-4">
    <div class="max-w-2xl">
      <span class="eyebrow">Nilai kami</span>
      <h2 id="values-title" class="mt-4 font-display text-[clamp(2rem,5vw,3.75rem)] font-medium leading-[1.05] tracking-[-0.015em]">
        Empat hal yang kami pegang di setiap botol.
      </h2>
    </div>

    <div class="mt-14 grid gap-4 md:grid-cols-3 md:grid-rows-2">
      <div class="stage relative min-h-[360px] md:row-span-2">
        <Image src={barrierImg} alt="ARN Skin Glowing Barrier Cream dengan ceramide, Cica, dan probiotik" widths={[480, 720, 960]} sizes="(min-width: 768px) 33vw, 92vw" class="absolute inset-0 h-full w-full object-cover" data-parallax />
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-indigo/80 to-transparent p-6 pt-24 sm:p-8 sm:pt-28">
          <p class="font-display text-2xl leading-snug text-cream sm:text-3xl">“Kulit yang sehat dimulai dari barrier yang kuat.”</p>
        </div>
      </div>
      {values.map((v, i) => (
        <article class={`stage flex flex-col justify-between gap-10 p-6 sm:p-8 ${i === 1 ? 'bg-blush/70' : i === 2 ? 'bg-indigo text-cream' : 'bg-cream'}`}>
          <span class={`grid h-12 w-12 place-items-center rounded-full ${i === 2 ? 'bg-cream/10' : 'bg-white/80'}`}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={v.icon} /></svg>
          </span>
          <div>
            <h3 class="font-display text-2xl font-medium leading-tight">{v.title}</h3>
            <p class={`mt-3 text-sm leading-relaxed ${i === 2 ? 'text-cream/70' : 'text-muted'}`}>{v.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
