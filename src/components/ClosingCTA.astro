---
import { Image } from 'astro:assets';
import { concerns, products } from '../data/products';

// TODO: replace with the real WhatsApp number and marketplace store URL
const intro = 'Halo ARN, saya ingin konsultasi ritual skincare yang cocok untuk kulit saya.';
const wa = (text: string) => 'https://wa.me/?text=' + encodeURIComponent(text);
const whatsapp = wa(intro);
const shop = '#ritual';

const bySlug = new Map(products.map((p) => [p.slug, p]));
const options = concerns.map((c) => {
  const picks = c.picks.map((pick) => ({ ...pick, product: bySlug.get(pick.slug)! }));
  const names = picks.map(({ product: p }) => `${p.name} (langkah ${p.step} ${p.ritual})`).join(', ');
  return {
    ...c,
    picks,
    href: wa(`${intro}\nKeluhan kulit saya: ${c.label.toLowerCase()}.\nSaran dari situs ARN: ${names}.\nApakah ini cocok untuk saya?`),
    announce: `Rekomendasi untuk ${c.label.toLowerCase()}: ${picks.map(({ product: p }) => p.name).join(', ')}.`,
  };
});
---

<section id="mulai" class="px-3 pb-3 sm:px-4 sm:pb-4" aria-labelledby="cta-title">
  <div class="stage bg-indigo px-5 py-20 text-cream sm:px-10 md:py-28" data-picker>

    <div class="relative mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
      <div>
        <h2 id="cta-title" class="font-display text-h2 font-medium" data-split>
          <span class="line"><span class="line-inner">Apa keluhan kulitmu?</span></span>
        </h2>
        <p class="mt-6 max-w-md text-body text-cream" data-reveal>
          Konsultasi gratis lewat WhatsApp. Pilih keluhan yang paling terasa, dan pesanmu sudah berisi produk ARN yang cocok untuk memulai. Tanpa kewajiban membeli.
        </p>

        <fieldset class="mt-10" data-reveal>
          <legend class="text-body font-semibold text-cream">Pilih keluhan kulitmu</legend>
          <div class="mt-4 flex flex-wrap gap-2.5">
            {options.map((c) => (
              <label class="chip">
                <input type="radio" name="keluhan" value={c.id} class="sr-only" data-wa={c.href} data-announce={c.announce} />
                <span class="chip-dot" aria-hidden="true"></span>
                {c.label}
              </label>
            ))}
          </div>
        </fieldset>
      </div>

      <div class="stage bg-cream p-6 text-ink sm:p-8 lg:self-start" data-reveal>
        <div class="lg:min-h-[20rem]">
          <div data-panel="default">
            <p class="font-display text-h3 font-medium">Belum yakin harus mulai dari mana?</p>
            <p class="mt-3 text-body text-ink">
              Pilih satu keluhan, dan kami tunjukkan langkah ritual ARN yang manfaatnya sesuai. Atau ceritakan langsung kondisi kulitmu lewat WhatsApp.
            </p>
            <ul class="mt-6 flex flex-wrap gap-3" aria-label="Lima langkah ritual ARN">
              {products.map((p) => (
                <li>
                  <a href={`#${p.slug}`} class="block w-16 text-center text-small font-semibold text-ink hover:text-indigo">
                    <Image src={p.image} alt="" widths={[128]} sizes="64px" class="h-16 w-16 rounded-2xl object-cover" />
                    <span class="mt-1.5 block">{p.ritual}</span>
                    <span class="sr-only">: ARN {p.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
          {options.map((c) => (
            <div data-panel={c.id}>
              <p class="font-display text-h3 font-medium">Untuk {c.label.toLowerCase()}, mulai dari:</p>
              <ul class="mt-5 space-y-4">
                {c.picks.map(({ product: p, why }) => (
                  <li class="flex items-center gap-4">
                    <Image src={p.image} alt="" widths={[128]} sizes="64px" class="h-16 w-16 shrink-0 rounded-2xl object-cover" />
                    <span>
                      <a href={`#${p.slug}`} class="block text-body font-semibold hover:text-indigo">ARN {p.name}</a>
                      <span class="block text-body text-ink">{why} <span class="text-muted">Langkah {Number(p.step)}, {p.ritual.toLowerCase()}.</span></span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={whatsapp} target="_blank" rel="noopener" class="btn bg-indigo text-cream hover:bg-ink" data-wa-link>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
            Chat lewat WhatsApp
          </a>
          <a href={shop} class="btn bg-blush text-ink hover:bg-rose">Lihat lima produknya</a>
        </div>
        <p class="mt-5 text-small text-ink">Seluruh produk terdaftar BPOM dan teruji klinis.</p>
        <p class="sr-only" aria-live="polite" data-announce-region></p>
      </div>
    </div>
  </div>
</section>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3rem;
    padding: 0.625rem 1.15rem;
    border-radius: 9999px;
    background: rgb(250 247 243 / 0.12);
    color: var(--color-cream);
    font-size: var(--text-body);
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.25s, color 0.25s;
  }
  .chip:hover { background: rgb(250 247 243 / 0.22); }
  .chip:has(:checked) { background: var(--color-blush); color: var(--color-ink); }
  .chip:has(:focus-visible) { outline: 2px solid var(--color-blush); outline-offset: 3px; }
  .chip-dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 9999px;
    background: rgb(250 247 243 / 0.45);
    transition: background-color 0.25s;
  }
  .chip:has(:checked) .chip-dot { background: var(--color-rose-deep); }

  /* the recommendation follows the checked radio with CSS alone, so it works without JS */
  [data-panel] { display: none; }
  [data-picker]:not(:has(input:checked)) [data-panel='default'] { display: block; }
  [data-picker]:has(input[value='kemerahan']:checked) [data-panel='kemerahan'],
  [data-picker]:has(input[value='jerawat']:checked) [data-panel='jerawat'],
  [data-picker]:has(input[value='kusam']:checked) [data-panel='kusam'],
  [data-picker]:has(input[value='kering']:checked) [data-panel='kering'],
  [data-picker]:has(input[value='matahari']:checked) [data-panel='matahari'] { display: block; }
</style>

<script>
  // JS only enriches: the WhatsApp message carries the chosen concern + recommended products
  const picker = document.querySelector<HTMLElement>('[data-picker]');
  const link = picker?.querySelector<HTMLAnchorElement>('[data-wa-link]');
  const live = picker?.querySelector<HTMLElement>('[data-announce-region]');
  picker?.addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    if (input.name !== 'keluhan' || !link) return;
    link.href = input.dataset.wa!;
    if (live) live.textContent = input.dataset.announce!;
  });
  // restore after back/forward cache keeps a checked radio
  const checked = picker?.querySelector<HTMLInputElement>('input[name="keluhan"]:checked');
  if (checked && link) link.href = checked.dataset.wa!;
</script>
