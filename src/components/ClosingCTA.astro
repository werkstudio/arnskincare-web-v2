---
import { Image } from 'astro:assets';
import tonerImg from '../assets/products/toner-editorial.jpg';

// TODO: replace with the real WhatsApp number and marketplace store URL
const whatsapp = 'https://wa.me/?text=' + encodeURIComponent('Halo ARN, saya ingin konsultasi ritual skincare yang cocok untuk kulit saya.');
const shop = '#ritual';
---

<section id="mulai" class="px-3 pb-3 sm:px-4 sm:pb-4" aria-labelledby="cta-title">
  <div class="stage bg-indigo px-5 pb-28 pt-20 text-cream sm:px-10 md:pb-40 md:pt-28">
    <div class="pointer-events-none absolute -right-40 top-0 h-[40rem] w-[40rem] rounded-full bg-rose/30 blur-[120px]" aria-hidden="true"></div>
    <!-- bookends the hero's giant word -->
    <p class="pointer-events-none absolute inset-x-0 -bottom-[0.18em] select-none text-center font-display text-[27vw] font-semibold leading-none tracking-[-0.055em] text-cream/[0.07]" aria-hidden="true">Lembut</p>

    <div class="relative mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-[1.2fr_1fr]">
      <div>
        <span class="eyebrow !text-blush" data-reveal>Konsultasi gratis</span>
        <h2 id="cta-title" class="mt-5 font-display text-[clamp(2.4rem,6vw,4.75rem)] font-medium leading-[1] tracking-[-0.02em]" data-split>
          <span class="line"><span class="line-inner">Ceritakan kulitmu.</span></span>
          <span class="line"><span class="line-inner">Kami bantu pilih</span></span>
          <span class="line"><span class="line-inner">ritualnya.</span></span>
        </h2>
        <p class="mt-6 max-w-md leading-relaxed text-cream/70" data-reveal>
          Kirim pesan tentang kondisi kulitmu lewat WhatsApp. Tim ARN akan menyarankan produk yang cocok untuk memulai, tanpa kewajiban membeli.
        </p>
        <div class="mt-9 flex flex-wrap gap-3" data-reveal>
          <a href={whatsapp} target="_blank" rel="noopener" class="btn bg-cream text-indigo hover:bg-blush">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
            Chat lewat WhatsApp
          </a>
          <a href={shop} class="btn border border-cream/30 text-cream hover:bg-cream/10">Lihat lima produknya</a>
        </div>
        <p class="mt-6 text-xs text-cream/50" data-reveal>Seluruh produk terdaftar BPOM dan teruji klinis.</p>
      </div>

      <div class="relative mx-auto aspect-[4/5] w-full max-w-sm" data-reveal>
        <div class="stage absolute inset-0" data-float>
          <Image src={tonerImg} alt="ARN Toner Essence dengan probiotik dan Salix Alba" widths={[400, 640, 800]} sizes="(min-width: 768px) 384px, 90vw" class="h-full w-full object-cover" />
        </div>
        <span class="pill absolute -left-3 top-[20%]"><span class="pill-dot">+</span>Bebas alkohol</span>
        <span class="pill absolute -right-3 bottom-[22%]"><span class="pill-dot">+</span>Probiotik</span>
      </div>
    </div>
  </div>
</section>
