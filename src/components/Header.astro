---
import { Image } from 'astro:assets';
import logo from '../assets/products/arn-black.png';

const links = [
  { href: '#cerita', label: 'Cerita' },
  { href: '#ritual', label: 'Ritual' },
  { href: '#nilai', label: 'Nilai' },
  { href: '#kepercayaan', label: 'Kepercayaan' },
];
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 px-4 pt-3 sm:px-6">
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between rounded-full px-4 py-2.5 transition-all duration-500 sm:px-6 [&.is-scrolled]:bg-cream/85 [&.is-scrolled]:backdrop-blur-xl [&.is-scrolled]:shadow-[0_10px_40px_-20px_rgb(28_27_34/0.35)]"
    aria-label="Navigasi utama"
    data-nav
  >
    <a href="#top" class="shrink-0" aria-label="ARN Skincare — kembali ke atas">
      <Image src={logo} alt="ARN Skincare" width={84} class="h-auto w-[68px] sm:w-[84px]" loading="eager" />
    </a>

    <ul class="hidden items-center gap-8 text-small font-medium md:flex">
      {links.map((l) => (
        <li><a href={l.href} class="relative py-1 text-ink transition hover:text-ink after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-ink after:transition hover:after:scale-x-100">{l.label}</a></li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <a href="#mulai" class="btn btn-primary hidden !px-5 !py-2.5 !text-small sm:inline-flex">Mulai ritual</a>
      <button
        type="button"
        class="grid h-10 w-10 place-items-center rounded-full bg-white/70 md:hidden"
        aria-label="Buka menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="relative block h-3 w-5" aria-hidden="true">
          <span class="absolute inset-x-0 top-0 h-[1.5px] bg-ink transition duration-300 [.is-open_&]:top-1/2 [.is-open_&]:rotate-45"></span>
          <span class="absolute inset-x-0 bottom-0 h-[1.5px] bg-ink transition duration-300 [.is-open_&]:bottom-1/2 [.is-open_&]:-rotate-45"></span>
        </span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="invisible fixed inset-x-4 top-[4.75rem] origin-top scale-95 rounded-[1.75rem] bg-cream/95 p-6 opacity-0 shadow-2xl backdrop-blur-xl transition duration-300 md:hidden [&.is-open]:visible [&.is-open]:scale-100 [&.is-open]:opacity-100"
    data-menu
  >
    <ul class="flex flex-col gap-1">
      {links.map((l) => (
        <li><a href={l.href} class="block rounded-2xl px-3 py-3 font-display text-h3" data-menu-link>{l.label}</a></li>
      ))}
    </ul>
    <a href="#mulai" class="btn btn-primary mt-4 w-full" data-menu-link>Mulai ritual</a>
  </div>
</header>

<script>
  const nav = document.querySelector('[data-nav]')!;
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menu = document.querySelector('[data-menu]')!;

  const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    menu.classList.toggle('is-open', open);
    toggle.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Tutup menu' : 'Buka menu');
  };
  toggle.addEventListener('click', () => setOpen(!menu.classList.contains('is-open')));
  menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>
