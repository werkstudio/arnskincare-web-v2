---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Story from '../components/Story.astro';
import Ritual from '../components/Ritual.astro';
import Values from '../components/Values.astro';
import Ingredients from '../components/Ingredients.astro';
import Trust from '../components/Trust.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="ARN Skincare — Skincare Lembut Terdaftar BPOM untuk Kulit Sensitif & Berjerawat"
  description="Rangkaian skincare ARN: facial wash, toner essence, serum, day cream SPF 50+ dan barrier cream dengan Cica, probiotik, ceramide & niacinamide. Teruji klinis dan terdaftar BPOM."
>
  <Header />
  <main id="main">
    <Hero />
    <Story />
    <Ritual />
    <Values />
    <Ingredients />
    <Trust />
    <ClosingCTA />
  </main>
  <Footer />
</Base>

<script>
  import '../scripts/motion';
</script>
